// handdrawn_bar_palette.ogs
// Recommended usage:
// run.section("D:\\path\\to\\handdrawn_bar_palette.ogs", Main);

[Main]
int nColorStart = 1;
int nColorNum = 8;

color(1) = rgb(230, 126, 128);
color(2) = rgb(247, 191, 105);
color(3) = rgb(141, 199, 146);
color(4) = rgb(123, 174, 228);
color(5) = rgb(180, 158, 219);
color(6) = rgb(113, 196, 201);
color(7) = rgb(244, 163, 129);
color(8) = rgb(188, 188, 188);

int nLayers = page.nlayers;
int iLayer, iPlot;

if(nLayers <= 0)
{
    type "[handdrawn_bar_palette] No active graph page/layer.";
    break 1;
}

for(iLayer = 1; iLayer <= nLayers; iLayer++)
{
    layer -s %(iLayer);
    int nPlots = layer.nplots;

    if(nPlots <= 0)
        continue;

    for(iPlot = 1; iPlot <= nPlots; iPlot++)
    {
        int idx = mod(iPlot-1, nColorNum) + nColorStart;
        set %(iPlot) -c %(idx);
        set %(iPlot) -k %(idx);
        set %(iPlot) -kf 1;
        set %(iPlot) -t 15;
        set %(iPlot) -w 1.2;
    }

    legendupdate mode:=1;
}

type "[handdrawn_bar_palette] done.";

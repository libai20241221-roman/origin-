// handdrawn_bar_palette.ogs
[Main]
type "[handdrawn_bar_palette] applying...";

color(1) = rgb(230, 126, 128);
color(2) = rgb(247, 191, 105);
color(3) = rgb(141, 199, 146);
color(4) = rgb(123, 174, 228);
color(5) = rgb(180, 158, 219);
color(6) = rgb(113, 196, 201);
color(7) = rgb(244, 163, 129);
color(8) = rgb(188, 188, 188);

// Compatibility mode: style currently active plot only.
set -c 1;
set -k 1;
set -kf 1;
set -t 15;
set -w 1.2;
legendupdate mode:=1;

type "[handdrawn_bar_palette] done. If no visible change, click a bar then run again.";

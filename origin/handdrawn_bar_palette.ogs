// handdrawn_bar_palette.ogs
// 用法：在 Origin 图窗口激活后，在 Script Window 执行：
// run.section(origin\\handdrawn_bar_palette, Main);
// 可选参数：
//   @NColorStart: 起始色索引（默认 1）
//   @NColorNum:   要应用的颜色数量（默认 8）

[Main]
// ---- 可配置参数 ----
if(@NColorStart==0)
    @NColorStart = 1;
if(@NColorNum==0)
    @NColorNum = 8;

// 默认“手绘风”色板（柔和、低饱和）
// Origin RGB() 形式
color(1) = rgb(230, 126, 128);   // 玫瑰红
color(2) = rgb(247, 191, 105);   // 蜂蜜黄
color(3) = rgb(141, 199, 146);   // 鼠尾草绿
color(4) = rgb(123, 174, 228);   // 粉笔蓝
color(5) = rgb(180, 158, 219);   // 淡紫
color(6) = rgb(113, 196, 201);   // 湖水青
color(7) = rgb(244, 163, 129);   // 杏橙
color(8) = rgb(188, 188, 188);   // 石墨灰

// 获取图层和绘图数量
int nLayers = layer.n;
int iLayer, iPlot;

for(iLayer = 1; iLayer <= nLayers; iLayer++)
{
    layer -s %(iLayer);

    int nPlots = wks.nplots;
    if(nPlots <= 0)
        continue;

    // 针对图层内每个数据绘图（柱）应用填充色
    for(iPlot = 1; iPlot <= nPlots; iPlot++)
    {
        int idx = mod(iPlot-1, @NColorNum) + @NColorStart;

        // 选择绘图
        set %(iPlot) -c %(idx);   // 边框色
        set %(iPlot) -k %(idx);   // 填充色
        set %(iPlot) -kf 1;       // 实心填充

        // 可选：轻微透明度，模拟手绘马克笔层叠
        set %(iPlot) -t 15;

        // 可选：边框加粗一点更像“描线”
        set %(iPlot) -w 1.2;
    }

    // 让图例跟随绘图样式自动更新
    legendupdate mode:=1;
}

type "[handdrawn_bar_palette] 已完成：柱色与图例已更新为手绘风色板。";
